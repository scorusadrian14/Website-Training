  const saptamani = Array.from({ length: totalSaptamani }, (_, i) => i + 1);
  console.log("saptamani", saptamani);

  //safe generate weeks and range
  const safeGetWorkWeekRange = (y, s) => {
    try {
      if (typeof getWorkWeekRange === 'function') return getWorkWeekRange(y, s);

    } catch (e) {
      return `Sapt. ${s}`;
    }
  }

  for (let i = 0; i < saptamani.length; i += 4) {
    console.log("i=", i);

    const tr = document.createElement("tr")
    console.log("tr", tr);

    for (let j = 0; j < 4; j++) {
      console.log("k este egal cu", j);

      const sapt = saptamani[i + j];
      console.log("sapt", sapt);

      if (!sapt) {
        tr.appendChild(document.createElement("td"));
        tr.appendChild(document.createElement("td"));
        continue;
      }
      const perioada = safeGetWorkWeekRange(year, sapt);
      console.log("perioada", perioada);

      const filePath = `activitati_simulator/${year}/activitati_simulator_${sapt}.pdf`;
      console.log("calea", filePath);

      const tdSapt = document.createElement("td");
      tdSapt.textContent = `S${sapt}`
      const tdProg = document.createElement("td");
      try {
        console.log(filePath);

        const response = await fetch(filePath, { method: "HEAD" });
        console.log(response);

        if (response.ok) {
          const a = document.createElement("a");
          a.href = filePath;
          a.textContent = perioada;
          a.target = "_blank";
          tdProg.appendChild(a);
        } else {
          tdProg.textContent = perioada;
        }
      } catch {
        tdProg.textContent = perioada;
      }
      tr.appendChild(tdSapt);
      tr.appendChild(tdProg);
    }
    tbody.appendChild(tr);
  }
}

